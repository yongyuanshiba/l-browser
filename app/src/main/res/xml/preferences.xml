<androidx.preference.PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android">

    <androidx.preference.Preference
        android:key="@string/pref_key_privacy"
        android:title="@string/privacy"
        android:summary="@string/preferences_privacy_summary"/>

    <androidx.preference.SwitchPreferenceCompat
        android:key="@string/pref_key_launch_external_app"
        android:defaultValue="false"
        android:title="@string/open_links_in_apps" />

    <androidx.preference.Preference
            android:key="@string/pref_key_make_default_browser"
            android:title="@string/preferences_make_default_browser"/>

    <org.mozilla.reference.browser.autofill.AutofillPreference
        android:key="@string/pref_key_autofill"
        android:title="@string/preferences_autofill"
        android:summary="@string/preferences_autofill_summary" />

    <androidx.preference.SwitchPreferenceCompat
        android:key="@string/pref_key_compose_ui"
        android:defaultValue="false"
        android:title="@string/preferences_compose_ui"/>

    <PreferenceCategory
        android:title="@string/developer_tools_category">

        <androidx.preference.SwitchPreferenceCompat
            android:key="@string/pref_key_remote_debugging"
            android:defaultValue="false"
            android:title="@string/preferences_remote_debugging" />

        <androidx.preference.Preference
            android:key="@string/pref_key_override_amo_collection"
            android:title="@string/preferences_customize_amo_collection"/>

    </PreferenceCategory>

    <PreferenceCategory
        android:title="@string/dns_category">

        <androidx.preference.ListPreference
            android:key="@string/pref_key_dns_mode"
            android:defaultValue="system"
            android:entries="@array/pref_dns_mode_entries"
            android:entryValues="@array/pref_dns_mode_values"
            android:title="@string/preferences_dns_mode"/>

        <androidx.preference.Preference
            android:key="@string/pref_key_dns_status"
            android:selectable="false"/>

    </PreferenceCategory>

    <PreferenceCategory
        android:title="主页">

        <androidx.preference.SwitchPreferenceCompat
            android:defaultValue="false"
            android:key="@string/pref_key_homepage_custom"
            android:summary="开启后，主页会加载下面粘贴的两段自定义代码"
            android:title="使用自定义代码" />

        <androidx.preference.Preference
            android:key="@string/pref_key_homepage_code"
            android:title="主页代码" />

        <androidx.preference.Preference
            android:key="pref_key_open_bookmarks"
            android:title="书签管理">
            <intent
                android:targetClass="org.mozilla.reference.browser.bookmarks.BookmarksActivity"
                android:targetPackage="com.jasmine.li" />
        </androidx.preference.Preference>

    </PreferenceCategory>

    <PreferenceCategory
        android:title="站点规则">

        <androidx.preference.Preference
            android:key="pref_key_site_rules"
            android:title="站点规则管理"
            android:summary="按域名设置 UA 伪装、桌面模式、强制暗色与兼容内核">
            <intent
                android:targetClass="org.mozilla.reference.browser.siterules.SiteRulesActivity"
                android:targetPackage="com.jasmine.li" />
        </androidx.preference.Preference>

    </PreferenceCategory>

    <PreferenceCategory
        android:title="@string/mozilla_category">

        <androidx.preference.Preference
            android:key="@string/pref_key_about_page"
            android:title="@string/preferences_about_page" />

    </PreferenceCategory>

</androidx.preference.PreferenceScreen>